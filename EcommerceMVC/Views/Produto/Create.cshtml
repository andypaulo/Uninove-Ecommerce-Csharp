@model EcommerceMVC.Models.Produto

@{
    ViewData["Title"] = "Cadastrar Produto";
    <style>

        .admin-page {
            max-width: 900px;
            margin: 40px auto;
            background: #ffffff;
            padding: 35px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

            .admin-page h2 {
                font-weight: 700;
                margin-bottom: 30px;
                color: #111;
            }

            .admin-page label {
                font-weight: 600;
                margin-bottom: 8px;
                display: block;
                color: #222;
            }

            .admin-page .form-control {
                border-radius: 10px;
                padding: 12px;
                border: 1px solid #dcdcdc;
                box-shadow: none;
            }

                .admin-page .form-control:focus {
                    border-color: #ff69b4;
                    box-shadow: 0 0 0 0.15rem rgba(255,105,180,0.2);
                }

            .admin-page .btn {
                border-radius: 10px;
                padding: 10px 18px;
                font-weight: 600;
            }

            .admin-page .card {
                border-radius: 14px;
                border: 1px solid #ececec;
            }

    </style>
}


<form asp-action="Create" method="post" class="mt-4">
    <div class="admin-page">
        <h2>Cadastrar Produto</h2>
        <div class="mb-3">
            <label>Nome</label>
            <input asp-for="Nome" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Descrição</label>
            <textarea asp-for="Descricao" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label>Preço</label>
            <input asp-for="Preco" type="number" step="0.01" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Estoque</label>
            <input asp-for="Estoque" type="number" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Imagem (URL)</label>
            <input asp-for="Imagem" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Categoria</label>
            <select asp-for="Categoria" class="form-control">
                <option value="">Selecione</option>
                <option value="Ação">Ação</option>
                <option value="Romance">Romance</option>
                <option value="Terror">Terror</option>
                <option value="Fantasia">Fantasia</option>
                <option value="Drama">Drama</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success">
            Cadastrar Produto
        </button>
    </div>

</form>