@model EcommerceMVC.Models.Produto

@{
    ViewData["Title"] = "Cadastrar Produto";
}

<h2>Cadastrar Produto</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label>Nome</label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Descrição</label>
        <textarea asp-for="Descricao" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>Preço</label>
        <input asp-for="Preco" type="number" step="0.01" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Estoque</label>
        <input asp-for="Estoque" type="number" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Imagem (URL)</label>
        <input asp-for="Imagem" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Categoria</label>

        <select asp-for="Categoria" class="form-control">
            <option value="">Selecione</option>
            <option value="Ação">Ação</option>
            <option value="Romance">Romance</option>
            <option value="Terror">Terror</option>
            <option value="Fantasia">Fantasia</option>
            <option value="Drama">Drama</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Cadastrar Produto
    </button>

</form>