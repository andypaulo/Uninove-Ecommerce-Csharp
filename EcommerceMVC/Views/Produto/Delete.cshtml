@model EcommerceMVC.Models.Produto

@{
    ViewData["Title"] = "Excluir produto";
    <style>

        .admin-page {
            max-width: 900px;
            margin: 40px auto;
            background: #ffffff;
            padding: 35px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

            .admin-page h2 {
                font-weight: 700;
                margin-bottom: 30px;
                color: #111;
            }

            .admin-page .card {
                border-radius: 14px;
                border: 1px solid #ececec;
                overflow: hidden;
            }

            .admin-page .card-body {
                padding: 30px;
            }

            .admin-page .card-title {
                font-size: 24px;
                font-weight: 700;
                margin-bottom: 25px;
                color: #111;
            }

            .admin-page dt {
                font-weight: 700;
                color: #222;
            }

            .admin-page dd {
                color: #555;
            }

            .admin-page .btn {
                border-radius: 10px;
                padding: 10px 18px;
                font-weight: 600;
            }

            .admin-page .acoes {
                margin-top: 30px;
                display: flex;
                gap: 12px;
            }

    </style>
}
<div class="admin-page">
    <h2>Excluir produto</h2>
    @if (TempData["ErroExclusao"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["ErroExclusao"]
        </div>
    }
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Tem certeza que deseja excluir este produto?</h5>

            <dl class="row mt-4">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Nome</dt>
                <dd class="col-sm-9">@Model.Nome</dd>

                <dt class="col-sm-3">Descrição</dt>
                <dd class="col-sm-9">@Model.Descricao</dd>

                <dt class="col-sm-3">Estoque</dt>
                <dd class="col-sm-9">@Model.Estoque</dd>

                <dt class="col-sm-3">Preço</dt>
                <dd class="col-sm-9">R$ @Model.Preco.ToString("N2")</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Confirmar exclusão</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
