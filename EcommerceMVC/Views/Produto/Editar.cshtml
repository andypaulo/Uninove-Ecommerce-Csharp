@model EcommerceMVC.Models.Produto
<style>

    .admin-page {
        max-width: 900px;
        margin: 40px auto;
        background: #ffffff;
        padding: 35px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

        .admin-page h2 {
            font-weight: 700;
            margin-bottom: 30px;
            color: #111;
        }

        .admin-page label {
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
            color: #222;
        }

        .admin-page .form-control {
            border-radius: 10px;
            padding: 12px;
            border: 1px solid #dcdcdc;
            box-shadow: none;
        }

            .admin-page .form-control:focus {
                border-color: #ff69b4;
                box-shadow: 0 0 0 0.15rem rgba(255,105,180,0.2);
            }

        .admin-page .btn {
            border-radius: 10px;
            padding: 10px 18px;
            font-weight: 600;
        }

        .admin-page .card {
            border-radius: 14px;
            border: 1px solid #ececec;
        }

</style>



<form asp-action="Editar" method="post" class="mt-4">
    <input type="hidden" asp-for="Id" />

    <div class="admin-page">
        <h2>Editar Produto</h2>
        <div>
            <label>Nome</label>
            <input asp-for="Nome" class="form-control" />
        </div>

        <div>
            <label>Descrição</label>
            <input asp-for="Descricao" class="form-control" />
        </div>

        <div>
            <label>Preço</label>
            <input asp-for="Preco" class="form-control" />
        </div>

        <div>
            <label>Estoque</label>
            <input asp-for="Estoque" class="form-control" />
        </div>

        <div>
            <label>Imagem</label>
            <input asp-for="Imagem" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Categoria</label>
            <select asp-for="Categoria" class="form-control">
                <option value="">Selecione</option>
                <option value="Ação">Ação</option>
                <option value="Romance">Romance</option>
                <option value="Terror">Terror</option>
                <option value="Fantasia">Fantasia</option>
                <option value="Drama">Drama</option>
            </select>
        </div>

        <br />

        <button type="submit" class="btn btn-primary">Salvar</button>
        <a href="/" class="btn btn-secondary">Voltar</a>
    </div>
</form>