<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Manga&Lamen</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EcommerceMVC.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/images/manga&lamenlogo.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <style>
        body, input, button, select, textarea {
            margin: 0;
            font-family: Poppins, sans-serif;
            background-color: #d3d3d3;
            padding-bottom: 60px;
        }

        .custom-header {
            background-color: #111;
            padding: 15px;
            text-align: center;
        }

            .custom-header input {
                width: 90%;
                padding: 10px;
                border-radius: 20px;
                border: none;
            }

        .custom-nav {
            background-color: #222;
            padding: 10px;
            gap: 20px;
            display: flex;
            justify-content: space-around;
        }

            .custom-nav a {
                color: white;
                text-decoration: none;
                font-size: 16px;
                display: inline-flex;
                align-items: center;
                gap: 6px; 
                transition: 0.2s;
            }

        .custom-nav a:hover {
            color: #d3d3d3;
        }

        .custom-nav a img,
        .custom-nav a svg {
            width: 16px !important;
            height: 16px !important;
            object-fit: contain;
            filter: brightness(0) invert(1);
        }

        .custom-footer {
            background-color: #eee;
            padding: 10px;
            display: flex;
            justify-content: space-around;
            position: fixed;
            bottom: 0;
            width: 100%;
            opacity: 82%;
        }

        .custom-footer p {
            margin: 0;
            padding: 0;
        }
    </style>
</head>
<body>

    <header class="custom-header">
        <div style="position: relative; width: 90%; margin: 0 auto;">
            <form method="get" action="@Url.Action("Index", "Home")" id="searchForm">
                <input type="hidden" name="categoria" value="@Context.Request.Query["categoria"]" />
                <input type="text"
                       id="inputPesquisa"
                       name="pesquisa"
                       placeholder="Buscar mangá..."
                       value="@Context.Request.Query["pesquisa"]"
                       autocomplete="off"
                       style="width: 100%;">
            </form>

            <div id="previewPesquisa" style="display: none; position: absolute; top: 100%; left: 0; width: 100%; background: white; border-radius: 0 0 10px 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.2); z-index: 999; text-align: left;">
                <ul id="listaSugestoes" style="list-style: none; margin: 0; padding: 0;"></ul>
            </div>
        </div>
    </header>

    <nav class="custom-nav">
        <a asp-controller="Home" asp-action="Contato">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M 12 2.0996094 L 1 12 L 4 12 L 4 21 L 11 21 L 11 15 L 13 15 L 13 21 L 20 21 L 20 12 L 23 12 L 12 2.0996094 z M 12 4.7910156 L 18 10.191406 L 18 11 L 18 19 L 15 19 L 15 13 L 9 13 L 9 19 L 6 19 L 6 10.191406 L 12 4.7910156 z"></path>
            </svg>
            Home
        </a>

        <a asp-controller="Home" asp-action="Index">
            <img width="16" height="16" src="https://img.icons8.com/windows/32/book-stack.png" alt="book-stack" />
            Mangá
        </a>

        <a href="/carrinho.html">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-cart" viewBox="0 0 16 16">
                <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2" />
            </svg>
            Carrinho
        </a>

        <a asp-controller="Produto" asp-action="Gerenciamento">
            <img width="16" height="16" src="https://img.icons8.com/ios/50/user--v1.png" alt="user--v1" />
            Admin
        </a>
    </nav>

    <div class="container-fluid p-0">
        <main role="main" class="pb-0">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer">
        <p>Todos os direitos Reservados © - Mangá & Lamen </p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const input = document.getElementById('inputPesquisa');
        const preview = document.getElementById('previewPesquisa');
        const lista = document.getElementById('listaSugestoes');

        input.addEventListener('input', async function() {
        const termo = this.value.trim();

        if (termo.length < 2) {
            preview.style.display = 'none';
            return;
        }

        try {
        const response = await fetch(`/Home/SugestoesPesquisa?pesquisa=${encodeURIComponent(termo)}`);
        const produtos = await response.json();

        if (produtos.length > 0) {
            lista.innerHTML = produtos.map(p => `
                <li style="padding: 10px 15px; border-bottom: 1px solid #eee; cursor: pointer;">
                    <a href="/Home/Details/${p.id}" style="text-decoration: none; color: #333; display: block; width: 100%;">
                        ${p.nome}
                    </a>
                </li>
            `).join('');

            preview.style.display = 'block';
        } else {
            preview.style.display = 'none';
        }
        } catch (error) {
            console.error('Erro ao buscar sugestões:', error);
        }
        });

        document.addEventListener('click', function(e) {
            if (!input.contains(e.target) && !preview.contains(e.target)) {
                preview.style.display = 'none';
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>