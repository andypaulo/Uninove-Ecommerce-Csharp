@model IEnumerable<EcommerceMVC.Models.Produto>

@{
    ViewData["Title"] = "Manga&Lamen Homepage";
}

<style>

    .mangas {
        padding: 20px;
    }

    .card {
        background-color: white;
        padding: 10px;
        border-radius: 10px;
    }

    .card img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 5px;
    }

    .card img:hover {
        transform: scale(1.05);
        transition: 0.3s;
    }

    .personagens {
        background-color: #222;
        padding: 20px;
        display: flex;
        justify-content: space-around;
    }

    .personagens img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
    }

    .destaques {
        padding: 20px;
    }

    .detail {
        text-decoration: none;
        color: inherit;
    }

    .paginacao-setas {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 100px;
        margin-top: 35px;
    }

    .seta-paginacao {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 3px solid #4a4a4a;
        color: #4a4a4a;
        text-decoration: none;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 22px;
        font-weight: bold;
        transition: 0.3s;
        background-color: white;
    }

    .seta-paginacao:hover {
        transform: scale(1.08);
        color: #222;
        border-color: #222;
    }

    .seta-desativada {
        opacity: 0.3;
        pointer-events: none;
    }

</style>

<section class="mb-4">

    <a href="/carrinho.html"
       class="btn btn-primary">

        Ir para Carrinho

    </a>

    <a asp-controller="Produto"
       asp-action="Gerenciamento"
       class="btn btn-dark">

        Painel de Gerenciamento

    </a>

</section>

<section class="mangas">

    <div class="container mt-4">

        <h2 class="mb-4 text-center">
            Produtos em Destaque
        </h2>

        <form method="get"
              asp-action="Index"
              class="mb-4">

            <div class="row justify-content-center">

                <div class="col-md-4">

                    <select name="categoria"
                            class="form-control">

                        <option value="">
                            Todas Categorias
                        </option>

                        <option value="Ação">
                            Ação
                        </option>

                        <option value="Romance">
                            Romance
                        </option>

                        <option value="Terror">
                            Terror
                        </option>

                        <option value="Fantasia">
                            Fantasia
                        </option>

                        <option value="Drama">
                            Drama
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-dark w-100">

                        Filtrar

                    </button>

                </div>

            </div>

        </form>

        <div class="row">

            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <img src="@(string.IsNullOrEmpty(item.Imagem)
                            ? Url.Content("~/images/sem-foto.jpg")
                            : (item.Imagem.StartsWith("http")
                                ? item.Imagem
                                : Url.Content("~/images/" + item.Imagem)))"

                             class="card-img-top"
                             alt="@item.Nome">

                        <div class="card-body d-flex flex-column">

                            <a asp-controller="Home"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="detail">

                                <h5 class="card-title">
                                    @item.Nome
                                </h5>

                                <p class="card-text text-muted">
                                    @item.Descricao
                                </p>

                                <h4 class="text-primary">
                                    R$ @item.Preco.ToString("N2")
                                </h4>

                            </a>

                            <button onclick="adicionarCarrinho(@item.Id)"
                                    class="btn btn-success w-100 mt-2">

                                🛒 Adicionar ao Carrinho

                            </button>
                        </div>

                    </div>

                </div>
            }

        </div>

        <div class="paginacao-setas">

            @if (ViewBag.PaginaAtual > 1)
            {
                <a href="@Url.Action("Index", new {
                    pagina = ViewBag.PaginaAtual - 1,
                    categoria = ViewBag.Categoria
                })"
                class="seta-paginacao">

                    ←

                </a>
            }
            else
            {
                <div class="seta-paginacao seta-desativada">

                    ←

                </div>
            }

            @if (ViewBag.PaginaAtual < ViewBag.TotalPaginas)
            {
                <a href="@Url.Action("Index", new {
                    pagina = ViewBag.PaginaAtual + 1,
                    categoria = ViewBag.Categoria
                })"
                class="seta-paginacao">

                    →

                </a>
            }
            else
            {
                <div class="seta-paginacao seta-desativada">

                    →

                </div>
            }

        </div>

        <div class="d-flex justify-content-center align-items-center gap-3 mt-3">

            <span style="color:white; font-size:18px;">

                Página @ViewBag.PaginaAtual
                de
                @ViewBag.TotalPaginas

            </span>

        </div>

    </div>

</section>

<section class="personagens">

    <img src="/images/char1.jpg">
    <img src="/images/char2.jpg">
    <img src="/images/char3.jpg">
    <img src="/images/char4.jpg">

</section>

<section class="destaques">
</section>

<script>

async function adicionarCarrinho(produtoId)
{
    try
    {
        const response =
            await fetch('/Carrinho/Adicionar',
            {
                method: 'POST',

                headers:
                {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(
                {
                    produtoId: produtoId
                })
            });

        if(response.ok)
        {
            alert('Produto adicionado ao carrinho!');
        }
        else
        {
            alert('Erro ao adicionar produto.');
        }
    }
    catch(error)
    {
        console.error(error);

        alert('Erro de conexão com o servidor.');
    }
}

</script>