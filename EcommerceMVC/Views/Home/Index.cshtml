@model IEnumerable<EcommerceMVC.Models.Produto>

@{
    ViewData["Title"] = "Manga&Lamen Homepage";
}

<style>

    .mangas {
        padding: 20px;
    }

    .card {
        background-color: white;
        padding: 10px;
        border-radius: 10px;
        overflow: hidden;
        border-radius: 12px;
    }

    .card img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: cover;
        border-radius: 5px;
    }

    .home-card-img {
        width: 100%;
        aspect-ratio: 2 / 3;
        object-fit: contain;
        background: #fff;
        padding: 8px;
        transition: 0.3s;
    }

    .card img:hover {
        transform: scale(1.05);
        transition: 0.3s;
    }

    .personagens {
        background-color: #222;
        width: 100%;
        min-height: 15vh;
        margin-bottom: 0;
        padding: 0;
    }

    .detail {
        text-decoration: none;
        color: inherit;
    }

    .paginacao-setas {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 100px;
        margin-top: 35px;
    }

    .seta-paginacao {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 3px solid #4a4a4a;
        color: #4a4a4a;
        text-decoration: none;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 22px;
        font-weight: bold;
        transition: 0.3s;
        background-color: white;
    }

    .seta-paginacao:hover {
        transform: scale(1.08);
        color: #222;
        border-color: #222;
    }

    .seta-desativada {
        opacity: 0.3;
        pointer-events: none;
    }

</style>

@if (TempData["AvisoEstoque"] != null)
{
    <div class="alert alert-warning text-center alert-dismissible fade show" role="alert">
        ⚠️ @TempData["AvisoEstoque"]
    </div>
}

<section class="mangas">

    <div class="container mt-4">

        <h2 class="mb-4 text-center">
            Produtos em Destaque
        </h2>

        <form method="get"
              asp-action="Index"
              class="mb-4">

            <div class="row justify-content-center">

                <div class="col-md-4">

                    <select name="categoria"
                            class="form-control">

                        <option value="">
                            Todas Categorias
                        </option>

                        <option value="Ação">
                            Ação
                        </option>

                        <option value="Romance">
                            Romance
                        </option>

                        <option value="Terror">
                            Terror
                        </option>

                        <option value="Fantasia">
                            Fantasia
                        </option>

                        <option value="Drama">
                            Drama
                        </option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-dark w-100">

                        Filtrar

                    </button>

                </div>

            </div>

        </form>

        <div class="row">

            @foreach (var item in Model)
            {
                bool esgotado = item.Estoque <= 0;

                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100 @(esgotado ? "opacity-75" : "")" style="position: relative;">

                        @if (esgotado)
                        {
                            <span class="badge bg-danger" style="position: absolute; top: 10px; left: 10px; z-index: 10; font-size: 0.9rem;">
                                Esgotado
                            </span>
                        }
                        <img src="@(string.IsNullOrEmpty(item.Imagem) ? Url.Content("~/images/sem-foto.jpg") : (item.Imagem.StartsWith("http") ? item.Imagem : Url.Content("~/images/" + item.Imagem)))"
                             class="home-card-img @(esgotado ? "grayscale" : "")"
                             alt="@item.Nome"
                             style="@(esgotado ? "filter: grayscale(100%);" : "")"
                         >

                        <div class="card-body d-flex flex-column">

                            <a asp-controller="Home"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="detail" style="text-decoration: none; color: inherit;">

                                <h5 class="card-title">
                                    @item.Nome
                                </h5>

                                <p class="card-text text-muted">
                                    @item.Descricao
                                </p>

                                <div class="mb-2">
                                    <span class="badge bg-secondary text-light">@item.Categoria</span>
                                </div>

                                <h4 class="text-primary">
                                    R$ @item.Preco.ToString("N2")
                                </h4>

                            </a>

                            <div class="mt-auto">
                                @if (esgotado)
                                {
                                    <button class="btn btn-secondary w-100 mt-2" disabled>
                                        Indisponível
                                    </button>
                                }
                                else
                                {
                                    <button onclick="comprarAgora(@item.Id)"
                                            class="btn btn-primary flex-grow-1 fw-bold w-100">
                                        Comprar Agora
                                    </button>
                                    <button onclick="adicionarCarrinho(@item.Id)"
                                            class="btn btn-success w-100 mt-2">
                                        Adicionar ao Carrinho
                                    </button>
                                }
                            </div>
                        </div>

                    </div>

                </div>
            }

        </div>

        <div class="paginacao-setas">

            @if (ViewBag.PaginaAtual > 1)
            {
                <a href="@Url.Action("Index", new {
                    pagina = ViewBag.PaginaAtual - 1,
                    categoria = ViewBag.Categoria
                })"
                class="seta-paginacao">

                    ←

                </a>
            }
            else
            {
                <div class="seta-paginacao seta-desativada">

                    ←

                </div>
            }

            @if (ViewBag.PaginaAtual < ViewBag.TotalPaginas)
            {
                <a href="@Url.Action("Index", new {
                    pagina = ViewBag.PaginaAtual + 1,
                    categoria = ViewBag.Categoria
                })"
                class="seta-paginacao">

                    →

                </a>
            }
            else
            {
                <div class="seta-paginacao seta-desativada">

                    →

                </div>
            }

        </div>

        <div class="d-flex justify-content-center align-items-center gap-3 mt-3">

            <span style="color:white; font-size:18px;">

                Página @ViewBag.PaginaAtual
                de
                @ViewBag.TotalPaginas

            </span>

        </div>

    </div>

</section>

<section class="personagens" >
</section>
<script>

    async function comprarAgora(produtoId) {
            try {
                const response = await fetch('/Carrinho/Adicionar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ produtoId: produtoId })
                });

                if (response.ok) {
                    window.location.href = '/carrinho.html';
                } else {
                    const textoErro = await response.text();
                    alert(textoErro || 'Erro ao iniciar processo de compra.');
                }
            } catch (error) {
                console.error(error);
                alert('Erro de conexão com o servidor.');
            }
        }

        async function adicionarCarrinho(produtoId) {
            try {
                const response = await fetch('/Carrinho/Adicionar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ produtoId: produtoId })
                });

                if (response.ok) {
                    alert('Produto adicionado ao carrinho!');
                } else {
                    const textoErro = await response.text();
                    alert(textoErro || 'Erro ao adicionar produto.');
                }
            } catch (error) {
                console.error(error);
                alert('Erro de conexão com o servidor.');
            }
        }

</script>